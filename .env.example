# ==============================================================================
# AI Appointment Booking SaaS - Environment Configuration
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Express Backend Port
PORT=5000

# Next.js Frontend URL (for CORS and client redirects)
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Connection URL (Prisma format)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_appointments?schema=public

# JWT Authentication Configuration
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars!
JWT_EXPIRES_IN=7d

# Mistral AI API Key
# Sign up at https://console.mistral.ai to obtain your API key.
# If omitted or unavailable, the backend gracefully falls back to an internal
# deterministic conversational parser for offline testing and demo integrity.
MISTRAL_API_KEY=your_mistral_api_key_here

# Optional: Next.js Frontend Public Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:5000/api
